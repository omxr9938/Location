//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  Smart Key Levels  –  Volumen-Bergkanten, Tages-H/L, Magic Numbers, Lern-Gedächtnis
//
//  Was der Indikator macht
//   1. Volumenprofil über die letzten N Bars -> findet Volumen-"Berge" (HVN),
//      deren Kanten (oben/unten), POC, VAH, VAL.
//   2. Tageshoch / Tagestief (heute) + Vortageshoch / Vortagestief.
//   3. Magic Numbers: runde Marken (auto-Schrittweite oder eigene) + eigene Liste.
//   4. "Lern-Gedächtnis": Jedes Swing-Hoch/-Tief wird gespeichert. Hält ein Level
//      bei weiteren Berührungen -> Stärke steigt. Wird es durchbrochen -> Stärke
//      sinkt. Alte, bewährte Level bleiben auch dann erhalten, wenn sie längst
//      aus dem Volumenprofil-Fenster gefallen sind.
//   5. Deine eigenen Zonen (Einstellungen -> "Meine Zonen") werden gezeichnet und
//      geben jedem Level in/nahe der Zone einen Score-Bonus.
//   6. Scoring + Clustering: alle Kandidaten werden zusammengeführt, nach
//      Volumen, Reaktionen (Rejections), Konfluenz, Magic Number, Zone bewertet.
//      Nur die besten N Level werden gezeichnet (★ = Qualität) + Tabelle.
// ═══════════════════════════════════════════════════════════════════════════
indicator("Smart Key Levels", shorttitle="SKL", overlay=true, max_bars_back=1000, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ───────────────────────────── Inputs ─────────────────────────────
G1 = "Auswahl"
maxLevels  = input.int(10, "Max. Anzahl Key-Levels", minval=1, maxval=15, group=G1)
minScore   = input.float(1.5, "Mindest-Score", minval=0.0, step=0.1, group=G1, tooltip="Höher = strenger, weniger Level")
mergeMult  = input.float(0.25, "Zusammenfassen (ATR-Faktor)", minval=0.05, step=0.05, group=G1, tooltip="Level näher als ATR*Faktor werden zu einem Cluster (Konfluenz)")
showTable  = input.bool(true, "Tabelle mit Top-Levels", group=G1)

G2 = "Volumenprofil"
lookback    = input.int(500, "Lookback (Bars)", minval=50, maxval=1000, group=G2)
rowsIn      = input.int(60, "Preiszeilen", minval=20, maxval=150, group=G2)
peakMin     = input.float(0.35, "Min. Höhe eines Bergs (Anteil POC)", minval=0.1, maxval=1.0, step=0.05, group=G2)
edgeFrac    = input.float(0.50, "Kanten-Schwelle (Anteil Gipfel)", minval=0.2, maxval=0.9, step=0.05, group=G2, tooltip="Bergkante = dort, wo das Volumen unter diesen Anteil des Gipfels fällt")
vaPct       = input.float(70.0, "Value Area %", minval=50.0, maxval=95.0, group=G2)
showProfile = input.bool(true, "Profil als Balken zeichnen", group=G2)
profWidth   = input.int(40, "Profil-Breite (Bars)", minval=10, maxval=150, group=G2)

G3 = "Tages-Hoch/Tief"
showDaily = input.bool(true, "Tages-/Vortages-H/L zeichnen", group=G3)

G4 = "Magic Numbers"
showMagic   = input.bool(true, "Magic Numbers zeichnen", group=G4)
magicMinor  = input.float(0.0, "Schrittweite (0 = automatisch)", minval=0.0, group=G4, tooltip="Beispiele: NQ/ES 100 bzw. 25, Gold 10, EURUSD 0.005. Mitte = 5x, Haupt = 10x der Schrittweite.")
magicCustom = input.text_area("", "Eigene Magic Numbers (getrennt durch ; oder Zeilenumbruch)", group=G4)

G5 = "Meine Zonen (Lern-Eingabe)"
zonesTxt = input.text_area("", "Zonen: von-bis ; von-bis ; einzelner Preis", group=G5, tooltip="Beispiel: 20100-20150; 19850; 1.0840-1.0855\nDezimal mit Punkt oder Komma. Zonen werden gezeichnet und bewerten Level mit Bonus.")

G6 = "Lern-Gedächtnis (Swings)"
swLen   = input.int(5, "Swing-Stärke (Bars links/rechts)", minval=2, maxval=20, group=G6)
swMax   = input.int(40, "Max. gespeicherte Swing-Level", minval=10, maxval=60, group=G6)

G7 = "Farben"
colRes  = input.color(color.new(#ef5350, 0), "Widerstand (über Preis)", group=G7)
colSup  = input.color(color.new(#26a69a, 0), "Unterstützung (unter Preis)", group=G7)
colDay  = input.color(color.new(#ffb300, 0), "Tages-H/L", group=G7)
colPDay = input.color(color.new(#42a5f5, 0), "Vortag-H/L", group=G7)
colMag  = input.color(color.new(#b388ff, 30), "Magic Numbers", group=G7)
colZone = input.color(color.new(#ffee58, 82), "Meine Zonen", group=G7)

// ───────────────────────────── Hilfsfunktionen ─────────────────────────────
f_parse(string txt) =>
    array<float> aLo = array.new<float>()
    array<float> aHi = array.new<float>()
    string t = str.replace_all(str.replace_all(txt, "\n", ";"), ",", ".")
    array<string> toks = str.split(t, ";")
    for tok in toks
        string s = str.trim(tok)
        if s != ""
            if str.contains(s, "-")
                array<string> parts = str.split(s, "-")
                if array.size(parts) >= 2
                    float a = str.tonumber(str.trim(array.get(parts, 0)))
                    float b = str.tonumber(str.trim(array.get(parts, 1)))
                    if not na(a) and not na(b)
                        array.push(aLo, math.min(a, b))
                        array.push(aHi, math.max(a, b))
            else
                float a = str.tonumber(s)
                if not na(a)
                    array.push(aLo, a)
                    array.push(aHi, a)
    [aLo, aHi]

f_cand(array<float> cP, array<float> cS, array<string> cT, float p, float s, string t) =>
    if not na(p)
        array.push(cP, p)
        array.push(cS, s)
        array.push(cT, t)
    true

f_addSwing(array<float> aP, array<float> aS, array<int> aL, float p, float s, float tol, int maxN) =>
    bool merged = false
    int n = array.size(aP)
    if n > 0
        for i = 0 to n - 1
            if math.abs(array.get(aP, i) - p) <= tol
                array.set(aS, i, array.get(aS, i) + s * 0.5)
                merged := true
                break
    if not merged
        array.push(aP, p)
        array.push(aS, s)
        array.push(aL, bar_index)
        if array.size(aP) > maxN
            int w = array.indexof(aS, array.min(aS))
            array.remove(aP, w)
            array.remove(aS, w)
            array.remove(aL, w)
    true

// Lernen: bei jeder Bar Berührung -> hält = Stärke hoch, Durchbruch = Stärke runter
f_updateSwing(array<float> aP, array<float> aS, array<int> aL, float tol) =>
    int n = array.size(aP)
    if n > 0
        for i = n - 1 to 0
            float p = array.get(aP, i)
            float s = array.get(aS, i) * 0.9995
            bool touched = low <= p + tol and high >= p - tol
            if touched and bar_index - array.get(aL, i) > 5
                bool broke = (open < p - tol and close > p + tol) or (open > p + tol and close < p - tol)
                s := broke ? s * 0.6 : s + 0.4
                array.set(aL, i, bar_index)
            array.set(aS, i, s)
            if s < 0.25
                array.remove(aP, i)
                array.remove(aS, i)
                array.remove(aL, i)
    true

f_magic(float p, float tol, float minor, float mid, float major) =>
    float sc = 0.0
    string tg = ""
    if math.abs(p - math.round(p / major) * major) <= tol
        sc := 1.0
        tg := "Magic-H"
    else if math.abs(p - math.round(p / mid) * mid) <= tol
        sc := 0.6
        tg := "Magic-M"
    else if math.abs(p - math.round(p / minor) * minor) <= tol
        sc := 0.3
        tg := "Magic"
    [sc, tg]

// ───────────────────────────── Berechnung je Bar ─────────────────────────────
atrV   = ta.atr(14)
volAvg = ta.sma(volume, 20)
ph     = ta.pivothigh(high, swLen, swLen)
pl     = ta.pivotlow(low, swLen, swLen)

// Tages-Hoch/Tief
newDay = timeframe.change("D")
var float dH = na
var float dL = na
var float pdH = na
var float pdL = na
var int dayStart = 0
if newDay
    pdH := dH
    pdL := dL
    dH := high
    dL := low
    dayStart := bar_index
else
    dH := math.max(dH, high)
    dL := math.min(dL, low)

// Swing-Gedächtnis
var swP = array.new<float>()
var swS = array.new<float>()
var swL = array.new<int>()
float swTol = na(atrV) ? 0.0 : atrV * 0.2
float volRatio = volAvg > 0 ? math.min(volume[swLen] / volAvg, 3.0) : 1.0
if not na(ph)
    f_addSwing(swP, swS, swL, ph, 1.0 + volRatio * 0.5, swTol, swMax)
if not na(pl)
    f_addSwing(swP, swS, swL, pl, 1.0 + volRatio * 0.5, swTol, swMax)
f_updateSwing(swP, swS, swL, swTol)

// Zeichen-Container
var array<line>  lns = array.new<line>()
var array<label> lbs = array.new<label>()
var array<box>   bxs = array.new<box>()
var table tbl = table.new(position.top_right, 4, 16, bgcolor=color.new(color.black, 35), border_width=1, border_color=color.new(color.gray, 60))

// ───────────────────────────── Letzte Bar: Analyse + Zeichnen ─────────────────────────────
if barstate.islast
    for l in lns
        line.delete(l)
    for lb in lbs
        label.delete(lb)
    for b in bxs
        box.delete(b)
    array.clear(lns)
    array.clear(lbs)
    array.clear(bxs)
    table.clear(tbl, 0, 0, 3, 15)

    int n = math.min(lookback, bar_index + 1)
    float tol = atrV * mergeMult
    float hiN = high
    float loN = low
    for i = 0 to n - 1
        hiN := math.max(hiN, high[i])
        loN := math.min(loN, low[i])
    int rows = rowsIn
    float rowH = (hiN - loN) / rows

    array<float>  cP = array.new<float>()
    array<float>  cS = array.new<float>()
    array<string> cT = array.new<string>()

    // ── Volumenprofil ──
    array<float> vols = array.new<float>(rows, 0.0)
    float maxRaw = 0.0
    if rowH > 0
        for i = 0 to n - 1
            int r1 = math.max(0, math.min(rows - 1, int(math.floor((low[i] - loN) / rowH))))
            int r2 = math.max(0, math.min(rows - 1, int(math.floor((high[i] - loN) / rowH))))
            float share = nz(volume[i]) / (r2 - r1 + 1)
            for r = r1 to r2
                array.set(vols, r, array.get(vols, r) + share)

        array<float> sm = array.new<float>(rows, 0.0)
        for r = 0 to rows - 1
            float a = array.get(vols, math.max(r - 1, 0))
            float b = array.get(vols, r)
            float c = array.get(vols, math.min(r + 1, rows - 1))
            array.set(sm, r, 0.25 * a + 0.5 * b + 0.25 * c)

        float maxV = array.max(sm)
        maxRaw := array.max(vols)
        float total = array.sum(vols)
        int pocRow = array.indexof(sm, maxV)

        if maxV > 0
            // POC
            f_cand(cP, cS, cT, loN + (pocRow + 0.5) * rowH, 1.6, "POC")

            // Berge + Kanten
            for r = 0 to rows - 1
                float v = array.get(sm, r)
                float left = r > 0 ? array.get(sm, r - 1) : 0.0
                float right = r < rows - 1 ? array.get(sm, r + 1) : 0.0
                if v >= left and v > right and v >= maxV * peakMin
                    int lo = r
                    while lo > 0 and array.get(sm, lo - 1) >= v * edgeFrac
                        lo -= 1
                    int up = r
                    while up < rows - 1 and array.get(sm, up + 1) >= v * edgeFrac
                        up += 1
                    float strength = v / maxV
                    f_cand(cP, cS, cT, loN + lo * rowH, 0.5 + 1.5 * strength, "Berg-Kante↓")
                    f_cand(cP, cS, cT, loN + (up + 1) * rowH, 0.5 + 1.5 * strength, "Berg-Kante↑")
                    f_cand(cP, cS, cT, loN + (r + 0.5) * rowH, 0.4 + 1.0 * strength, "HVN")

            // Value Area
            int vaLo = pocRow
            int vaHi = pocRow
            float acc = array.get(vols, pocRow)
            while acc < total * vaPct / 100.0 and (vaLo > 0 or vaHi < rows - 1)
                float dn = vaLo > 0 ? array.get(vols, vaLo - 1) : -1.0
                float upv = vaHi < rows - 1 ? array.get(vols, vaHi + 1) : -1.0
                if upv >= dn
                    vaHi += 1
                    acc += array.get(vols, vaHi)
                else
                    vaLo -= 1
                    acc += array.get(vols, vaLo)
            f_cand(cP, cS, cT, loN + (vaHi + 1) * rowH, 1.0, "VAH")
            f_cand(cP, cS, cT, loN + vaLo * rowH, 1.0, "VAL")

            // Profil-Balken
            if showProfile
                for r = 0 to rows - 1
                    float vv = array.get(vols, r)
                    int w = math.max(1, int(profWidth * vv / maxRaw))
                    bool isPeak = array.get(sm, r) >= maxV * peakMin
                    color bc = r == pocRow ? color.new(#ffb300, 35) : isPeak ? color.new(#42a5f5, 55) : color.new(color.gray, 78)
                    array.push(bxs, box.new(bar_index + 2, loN + (r + 1) * rowH, bar_index + 2 + w, loN + r * rowH, border_color=na, bgcolor=bc))

    // ── Tages-H/L ──
    f_cand(cP, cS, cT, pdH, 1.3, "Vortag-H")
    f_cand(cP, cS, cT, pdL, 1.3, "Vortag-T")
    f_cand(cP, cS, cT, dH, 0.9, "Tages-H")
    f_cand(cP, cS, cT, dL, 0.9, "Tages-T")

    // ── Gelernte Swing-Level ──
    int nsw = array.size(swP)
    if nsw > 0
        for i = 0 to nsw - 1
            f_cand(cP, cS, cT, array.get(swP, i), 0.4 + 0.35 * math.min(array.get(swS, i), 5.0), "Swing")

    // ── Clustering (höchster Score zuerst, Nachbarn addieren 50 %) ──
    array<float>  clP = array.new<float>()
    array<float>  clS = array.new<float>()
    array<string> clT = array.new<string>()
    int nc = array.size(cP)
    if nc > 0
        array<int> idx = array.sort_indices(cS, order.descending)
        for k = 0 to nc - 1
            int j = array.get(idx, k)
            float p = array.get(cP, j)
            float s = array.get(cS, j)
            string t = array.get(cT, j)
            int found = -1
            int ncl = array.size(clP)
            if ncl > 0
                for c = 0 to ncl - 1
                    if math.abs(array.get(clP, c) - p) <= tol
                        found := c
                        break
            if found >= 0
                array.set(clS, found, array.get(clS, found) + s * 0.5)
                if not str.contains(array.get(clT, found), t)
                    array.set(clT, found, array.get(clT, found) + " + " + t)
            else
                array.push(clP, p)
                array.push(clS, s)
                array.push(clT, t)

    // ── Meine Zonen + eigene Magic Numbers ──
    [zLo, zHi] = f_parse(zonesTxt)
    [mLo, mHi] = f_parse(magicCustom)

    float minorStep = magicMinor > 0 ? magicMinor : math.pow(10, math.floor(math.log10(close)) - 2)
    float midStep = minorStep * 5
    float majorStep = minorStep * 10

    // ── Bonus + Reaktions-Scoring je Cluster ──
    array<int>    clTouch = array.new<int>()
    array<int>    clReact = array.new<int>()
    int ncl2 = array.size(clP)
    if ncl2 > 0
        for c = 0 to ncl2 - 1
            float p = array.get(clP, c)
            float s = array.get(clS, c)
            string t = array.get(clT, c)

            [msc, mtg] = f_magic(p, tol, minorStep, midStep, majorStep)
            if msc > 0
                s += msc
                t += " + " + mtg
            int nm = array.size(mLo)
            if nm > 0
                for i = 0 to nm - 1
                    if math.abs(array.get(mLo, i) - p) <= tol
                        s += 1.0
                        t += " + Magic(eigen)"
                        break
            int nz_ = array.size(zLo)
            if nz_ > 0
                for i = 0 to nz_ - 1
                    if p >= array.get(zLo, i) - tol and p <= array.get(zHi, i) + tol
                        s += 1.5
                        t += " + Meine Zone"
                        break

            int touches = 0
            int react = 0
            int lastHit = -100
            for i = 0 to n - 1
                bool hit = low[i] <= p + tol and high[i] >= p - tol
                if hit
                    if i - lastHit > 3
                        touches += 1
                        bool rejDown = high[i] <= p + tol * 2 and close[i] < p - tol * 0.5
                        bool rejUp = low[i] >= p - tol * 2 and close[i] > p + tol * 0.5
                        if rejDown or rejUp
                            react += 1
                    lastHit := i
            s += math.min(react, 6) * 0.3 + math.min(touches, 8) * 0.05
            array.set(clS, c, s)
            array.set(clT, c, t)
            array.push(clTouch, touches)
            array.push(clReact, react)

        // ── Beste auswählen + zeichnen ──
        array<int> order_ = array.sort_indices(clS, order.descending)
        float bestS = array.get(clS, array.get(order_, 0))
        int shown = 0
        int labelX = bar_index + (showProfile ? profWidth + 6 : 4)
        for k = 0 to ncl2 - 1
            int c = array.get(order_, k)
            float s = array.get(clS, c)
            if s >= minScore and shown < maxLevels
                float p = array.get(clP, c)
                float rel = s / bestS
                int stars = rel >= 0.75 ? 3 : rel >= 0.5 ? 2 : 1
                color col = p >= close ? colRes : colSup
                string txt = str.repeat("★", stars) + " " + array.get(clT, c) + "  " + str.tostring(p, format.mintick)
                array.push(lns, line.new(bar_index - math.min(bar_index, 250), p, bar_index, p, color=col, width=stars, extend=extend.right))
                array.push(lbs, label.new(labelX, p, txt, style=label.style_label_left, color=color.new(col, 85), textcolor=col, size=size.small))
                if showTable
                    table.cell(tbl, 0, shown, str.repeat("★", stars), text_color=col, text_size=size.small)
                    table.cell(tbl, 1, shown, str.tostring(p, format.mintick), text_color=col, text_size=size.small)
                    table.cell(tbl, 2, shown, str.tostring(s, "#.0"), text_color=color.gray, text_size=size.small)
                    table.cell(tbl, 3, shown, array.get(clT, c) + " [T" + str.tostring(array.get(clTouch, c)) + "/R" + str.tostring(array.get(clReact, c)) + "]", text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
                shown += 1

    // ── Tages-Linien ──
    if showDaily
        if not na(dH)
            array.push(lns, line.new(dayStart, dH, bar_index, dH, color=colDay, width=1, extend=extend.right))
            array.push(lbs, label.new(bar_index + 1, dH, "Tages-H", style=label.style_label_left, color=color.new(colDay, 90), textcolor=colDay, size=size.tiny))
        if not na(dL)
            array.push(lns, line.new(dayStart, dL, bar_index, dL, color=colDay, width=1, extend=extend.right))
            array.push(lbs, label.new(bar_index + 1, dL, "Tages-T", style=label.style_label_left, color=color.new(colDay, 90), textcolor=colDay, size=size.tiny))
        if not na(pdH)
            array.push(lns, line.new(dayStart, pdH, bar_index, pdH, color=colPDay, width=1, style=line.style_dashed, extend=extend.right))
            array.push(lbs, label.new(bar_index + 1, pdH, "Vortag-H", style=label.style_label_left, color=color.new(colPDay, 90), textcolor=colPDay, size=size.tiny))
        if not na(pdL)
            array.push(lns, line.new(dayStart, pdL, bar_index, pdL, color=colPDay, width=1, style=line.style_dashed, extend=extend.right))
            array.push(lbs, label.new(bar_index + 1, pdL, "Vortag-T", style=label.style_label_left, color=color.new(colPDay, 90), textcolor=colPDay, size=size.tiny))

    // ── Magic Numbers zeichnen (nahe am Preis) ──
    if showMagic
        int base = int(math.floor(close / midStep))
        for k = -4 to 5
            float mp = (base + k) * midStep
            bool isMajor = math.abs(mp - math.round(mp / majorStep) * majorStep) < midStep * 0.01
            array.push(lns, line.new(bar_index - math.min(bar_index, 250), mp, bar_index, mp, color=isMajor ? colMag : color.new(colMag, 70), width=1, style=line.style_dotted, extend=extend.right))
            if isMajor
                array.push(lbs, label.new(bar_index + 1, mp, "✦ " + str.tostring(mp, format.mintick), style=label.style_label_left, color=color.new(colMag, 92), textcolor=colMag, size=size.tiny))
        int nmc = array.size(mLo)
        if nmc > 0
            for i = 0 to nmc - 1
                float mp = array.get(mLo, i)
                array.push(lns, line.new(bar_index - math.min(bar_index, 250), mp, bar_index, mp, color=colMag, width=2, style=line.style_dotted, extend=extend.right))
                array.push(lbs, label.new(bar_index + 1, mp, "✦ " + str.tostring(mp, format.mintick), style=label.style_label_left, color=color.new(colMag, 90), textcolor=colMag, size=size.tiny))

    // ── Meine Zonen zeichnen ──
    int nzz = array.size(zLo)
    if nzz > 0
        for i = 0 to nzz - 1
            float zl = array.get(zLo, i)
            float zh = array.get(zHi, i)
            if zh - zl < syminfo.mintick
                zh := zl + math.max(tol * 0.3, syminfo.mintick)
            array.push(bxs, box.new(bar_index - math.min(bar_index, 250), zh, bar_index, zl, border_color=color.new(colZone, 30), bgcolor=colZone, extend=extend.right))
            array.push(lbs, label.new(bar_index + 1, (zh + zl) / 2, "Meine Zone", style=label.style_label_left, color=color.new(colZone, 90), textcolor=color.yellow, size=size.tiny))
